# Copy this file to .env (never commit .env). docker compose reads it automatically.

# --- Guardian's own API: the token City Brain and the Twin must send to us (Authorization: Bearer <token>) ---
# Make it long and random:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GUARDIAN_TOKEN=change-me-to-a-long-random-value
# Optional narrower tokens (each unique, at least 16 characters). Brain: read verdicts only. Twin: send readings only.
# GUARDIAN_TOKEN_BRAIN=
# GUARDIAN_TOKEN_TWIN=
# Optional: lets a partner (the City Brain) post to the shared timeline only, without the admin token.
# GUARDIAN_TOKEN_TIMELINE=
# Local demo with NO authentication (leave empty for anything connected to other teams)
GUARDIAN_DEMO=

# --- Connecting to the Twin team's layer (leave empty to run on our own mocks) ---
# GUARDIAN_PROFILE=twin
# The guardian-role token the Twin owner gives you privately (their TWIN_TOKEN_GUARDIAN)
# TWIN_TOKEN_GUARDIAN=
# Where their Twin runs, for example http://192.168.1.20:8000 (no trailing slash)
# TWIN_URL=
